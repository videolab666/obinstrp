#include <plugin-support.h>
#include <obs-module.h>

#include <stdarg.h>
#include <stdio.h>

const char *PLUGIN_NAME = "@CMAKE_PROJECT_NAME@";
const char *PLUGIN_VERSION = "@CMAKE_PROJECT_VERSION@";

void obs_log(int log_level, const char *format, ...)
{
	char prefixed[2048];
	snprintf(prefixed, sizeof(prefixed), "[%s] %s", PLUGIN_NAME ? PLUGIN_NAME : "Pitel Instant Replay",
		 format ? format : "");

	va_list args;
	va_start(args, format);
	blogva(log_level, prefixed, args);
	va_end(args);
}
